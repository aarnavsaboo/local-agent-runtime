{
  "name": "local-rag-summary",
  "concurrency": 3,
  "nodes": [
    {
      "id": "retrieve",
      "type": "retrieve",
      "config": {
        "corpus": "examples/corpus.jsonl",
        "query": "{{input.question}}",
        "top_k": 3,
        "max_chars": 6000
      }
    },
    {
      "id": "prompt",
      "type": "template",
      "depends_on": ["retrieve"],
      "config": {
        "text": "Use the passages to answer concisely.\n\n{{nodes.retrieve.text}}\n\nQuestion: {{input.question}}"
      }
    },
    {
      "id": "answer",
      "type": "ollama",
      "depends_on": ["prompt"],
      "retries": 1,
      "timeout_seconds": 120,
      "config": {
        "model": "qwen3:4b",
        "prompt": "{{nodes.prompt.text}}",
        "max_tokens": 160,
        "temperature": 0.0
      }
    }
  ]
}
